STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Vacío a propósito: es el valor de esta plantilla y en producción no sirve.
# Cada secreto debe ser distinto del otro, de al menos 32 caracteres,
# y no puede ser supersecret, changeme, secret ni password.
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
COOKIE_SECRET=

# Cadena de Postgres de ESTE entorno. Sin credenciales reales en el repositorio.
DATABASE_URL=
DB_NAME=medusa-backend

# SSL de Postgres. CI no cambia el valor por defecto.
# false (también 0, off, no, disable, disabled): sin SSL. En producción
# solo escribe una advertencia; no corta el arranque.
# DATABASE_SSL=require, y cualquier otro valor distinto de ese apagado,
# verifica el certificado. No hay un modo que cifre sin verificar.
# Vacío: apagado si NODE_ENV no es producción; encendido con verificación si
# NODE_ENV es production o prod (también con espacios o mayúsculas).
# No uses rejectUnauthorized: false.
# UNSAFE_SKIP_STARTUP_CHECKS no apaga el SSL.
# pg y pg-connection-string pisan el objeto ssl con la query de DATABASE_URL.
# Se quitan ssl, sslmode, sslcert, sslkey, sslpassword, sslrootcert,
# uselibpqcompat y sslnegotiation. Un ?sslmode=require del proveedor no se usa.
# El CA propio va en DATABASE_CA_CERT, no en sslrootcert.
# PGSSLMODE no pisa el objeto: ssl siempre se define (false o verificación).
DATABASE_SSL=
# Opcional. PEM (los saltos de línea como \n) o ruta a un archivo PEM
# si el proveedor usa un CA propio. Solo se lee cuando SSL está encendido.
DATABASE_CA_CERT=
# UNSAFE_SKIP_STARTUP_CHECKS=true omite solo el chequeo de secretos al arrancar
# y escribe una advertencia. No lo definas en producción. No afecta el SSL.
