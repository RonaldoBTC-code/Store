STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# PayPhone (Ecuador). Leave these empty in git. Set them only in the host environment.
# Token from Payphone Developer > Credenciales. Sent as Authorization: Bearer.
# https://docs.payphone.app/configuracion-de-ambiente-y-credenciales
PAYPHONE_TOKEN=
# StoreId from the same Credenciales screen.
PAYPHONE_STORE_ID=
# Storefront URL PayPhone redirects to after the customer pays. PayPhone appends
# id and clientTransactionId. Register this URL as URL de Respuesta, and register
# the site origin as Dominio Web, on a WEB application in Payphone Developer.
# Example: https://tienda.example.com/api/payphone/return
PAYPHONE_RESPONSE_URL=
# Storefront URL opened when the customer closes the PayPhone form.
# Example: https://tienda.example.com/ec/checkout?step=payment&payphone=cancelled
PAYPHONE_CANCELLATION_URL=
# Manual checkout (pp_system_default) is available when NODE_ENV is not production.
# Set to true to allow it in production, or false to disable it in every environment.
ALLOW_TEST_PAYMENTS=
