# Copy to .env.local:
#   cp .env.template .env.local
# Names and placeholders only. Do not put real secrets here.

# Required. Publishable key from Medusa Admin, Settings, Publishable API keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Medusa backend. The storefront defaults to http://localhost:9000 when this is unset.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Launch market. The storefront home is /ec.
NEXT_PUBLIC_DEFAULT_REGION=ec

# Absolute storefront URL. The code default is https://localhost:8000.
NEXT_PUBLIC_BASE_URL=https://localhost:8000

# Optional. Checkout reads this, then NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY.
NEXT_PUBLIC_STRIPE_KEY=

# Optional Medusa Payments values read by the checkout payment wrapper.
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Optional. Used by next-sitemap as the site URL.
NEXT_PUBLIC_VERCEL_URL=http://localhost:8000

# Optional. Host allow-list for next/image when product files live on Medusa Cloud S3.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
