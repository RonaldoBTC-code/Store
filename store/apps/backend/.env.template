STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Vacío a propósito: es el valor de esta plantilla y en producción no sirve.
# Cada secreto debe ser distinto del otro, de al menos 32 caracteres,
# y no puede ser supersecret, changeme, secret ni password.
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
COOKIE_SECRET=

# Cadena de Postgres de ESTE entorno. Sin credenciales reales en el repositorio.
DATABASE_URL=
DB_NAME=medusa-backend

# SSL de Postgres. CI no cambia el valor por defecto.
# false: sin SSL. En producción solo escribe una advertencia; no corta el arranque.
# true: SSL con verificación de certificado.
# Vacío: apagado si NODE_ENV no es producción; encendido con verificación si
# NODE_ENV es production o prod (también con espacios o mayúsculas).
# No uses rejectUnauthorized: false.
# UNSAFE_SKIP_STARTUP_CHECKS no apaga el SSL.
DATABASE_SSL=
# Opcional. PEM (los saltos de línea como \n) o ruta a un archivo PEM
# si el proveedor usa un CA propio. Solo se lee cuando SSL está encendido.
DATABASE_CA_CERT=
# UNSAFE_SKIP_STARTUP_CHECKS=true omite solo el chequeo de secretos al arrancar
# y escribe una advertencia. No lo definas en producción. No afecta el SSL.
