# Dependencies and build
**/node_modules/
**/.next/
**/.medusa/
**/.turbo/
**/dist/
**/build/
**/.cache/

# Secretos y entorno local. Las plantillas sí se versionan.
**/.env*
!**/.env.template
!**/.env.example

# Llaves y volcados. Los archivos .sql de migración siguen versionados.
*.key
*.dump
backups/

# Logs and OS
*.log
.DS_Store
Thumbs.db

# One-off admin loader with local credentials
store/scripts/load-cap-products.mjs

# Duplicate generated product photos (source lives in Producto/)
store/apps/backend/static/*.jpg
store/apps/backend/static/*-alt.png
